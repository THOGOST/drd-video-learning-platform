// DRD — Video Learning Platform Schema
// وفق الجدول 5 من المستند (قاعدة البيانات المقترحة)
// ملاحظة: البيئة الحالية تعمل بـ SQLite، والانتقال إلى PostgreSQL
// يتطلب فقط تغيير provider إلى "postgresql" دون تعديل الموديلات.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── users: بيانات المستخدمين والصلاحيات ───
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // ADMIN | STUDENT
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments CourseEnrollment[]
  progress    Progress[]
}

// ─── courses: الكورسات ───
model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  thumbnail   String?
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  enrollments CourseEnrollment[]
}

// ─── lessons: الدروس والفيديوهات ───
model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int      @default(0)
  duration    Int      @default(0) // بالثواني
  driveFileId String?  // Google Drive File ID (FR-12)
  videoUrl    String?  // رابط فيديو مباشر (بديل/إضافة لـ Drive)
  videoSource String   @default("direct") // direct | drive
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  links    LessonLink[]
  progress Progress[]

  @@index([courseId, orderIndex])
}

// ─── lesson_links: الروابط والموارد الإضافية ───
model LessonLink {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  url       String
  type      String   @default("link") // link | file | github | doc
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── progress: تقدم المستخدم (نظام حفظ التقدم — القسم 11) ───
model Progress {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  lastPosition    Int      @default(0) // آخر ثانية مشاهدة
  progressPercent Int      @default(0) // 0 → 100
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ─── course_enrollments: ربط المستخدم بالكورس ───
model CourseEnrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ─── سجل الأنشطة والأخطاء (القسم 6: Logging) ───
model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String   // LOGIN | REGISTER | COURSE_CREATE | LESSON_UPDATE | WORKFLOW_RUN ...
  entity    String?  // course | lesson | link | user | workflow
  entityId  String?
  detail    String?
  level     String   @default("INFO") // INFO | WARN | ERROR
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── سجل تشغيلات الـ Workflow (القسم 12) ───
model WorkflowRun {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("SUCCESS") // SUCCESS | WARNING | FAILED
  result    String? // JSON
  createdAt DateTime @default(now())
}
