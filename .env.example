# ══════════════════════════════════════════════════════════════
# DRD Video Learning Platform — Environment Variables
# ──────────────────────────────────────────────────────────────
# محليًا: انسخ الملف إلى .env وعدّل القيم
# على Vercel: Settings → Environment Variables → أضف نفس الأسماء
# ══════════════════════════════════════════════════════════════

# ─── 1) قاعدة البيانات (إجباري على Vercel — Supabase PostgreSQL) ───
# من: Supabase → Project Settings → Database → Connection Pooling
# استخدم منفذ 6543 (Transaction Pooler) وهو المناسب لـ Vercel Serverless
# لا تنسَ استبدال [YOUR-PASSWORD] بكلمة مرور قاعدة البيانات
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ─── 2) التطوير المحلي فقط (SQLite — لا يُستخدم على Vercel) ───
# DATABASE_URL=file:./db/custom.db

# ─── 3) أسرار المصادقة (إجباري في الإنتاج) ───
# أنشئ سلسلة عشوائية طويلة، مثال: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ─── 4) Supabase JS Client (اختياري — لفحص الحالة في لوحة الأدمن) ───
# من: Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── 5) تشغيل دروس Google Drive بجودة أصلية (اختياري — موصى به) ───
# بدون المفتاح: تُشغَّل الدروس عبر مشغل Drive المدمج الذي يغيّر الجودة تلقائيًا
# مع المفتاح: يظهر وضع «جودة أصلية» يشغّل الملف الأصلي بجودته الكاملة حتى في ملء الشاشة
# الخطوات: console.cloud.google.com → أنشئ مشروعًا → Library → فعّل Google Drive API
#          → Credentials → Create Credentials → API Key
#          → قيّد المفتاح: API restrictions = Google Drive API + Website restrictions = نطاق موقعك
NEXT_PUBLIC_GOOGLE_API_KEY=your-google-api-key

# ─── ملاحظات ───
# • المتغيرات التي تبدأ بـ NEXT_PUBLIC_ تظهر في المتصفح — لا تضع فيها أسرارًا
#   (مفتاح Drive API استثناء آمن: قيّده بنطاق موقعك وبهيئة Drive API فقط، وهو يتيح فقط الملفات العامة)
# • SUPABASE_SERVICE_ROLE_KEY للسيرفر فقط (يتجاوز RLS)
# • بعد إضافة المتغيرات في Vercel اضغط Redeploy حتى تُطبّق
