# ─── قاعدة البيانات الحالية (SQLite محلي) ───
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── أسرار المصادقة ───
SESSION_SECRET=change-me-in-production

# ─── Supabase (انسخها من Project Settings → API) ───
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Supabase PostgreSQL (لتحويل Prisma — انظر supabase/README.md) ───
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
